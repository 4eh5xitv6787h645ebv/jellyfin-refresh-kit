      "generationProbe": "gelato-jf10",
      "stampingExpectation": "observe",
      "cacheExpectation": "required",
      "requiredStampedArtifacts": [],
      "quarantinedAssertions": [
        "Hover/playback behavior is not asserted without seeded Trickplay or trailer data."
      ],
      "service": "jf10",
      "webrootExpectation": "read-only",
      "requiredPresentArtifacts": [],
      "requiredBodyMarkers": {},
      "configurationPatches": [
        {
          "artifactId": "gelato-jf10",
          "payload": {
            "EnableJavaScriptInjection": true
          }
        }
      ],
      "contentProbes": [
        {
          "id": "javascript-injector-public",
          "path": "/JavaScriptInjector/public.js",
          "authenticated": false,
          "markers": {
            "gelato-jf10": [
              "(from Gelato)",
              "jellyfin_local_search_enabled"
            ],
            "jellyfin-oscars-jf10": [
              "(from Jellyfin Oscars)",
              "__jellyfinOscarsInitialized"
            ]
          }
        },
        {
          "id": "javascript-injector-private",
          "path": "/JavaScriptInjector/private.js",
          "authenticated": true,
          "markers": {
            "discontinue-watching-jf10": [
              "(from DiscontinueWatching)",
              "[DiscontinueWatching] Initializing"
            ],
            "jellysleep-jf10": [
              "(from Jellysleep)",
              "Sleep Timer Plugin for Jellyfin"
            ]
          }
        }
      ]
    },
