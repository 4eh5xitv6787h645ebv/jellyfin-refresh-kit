    {
      "id": "jf10-registration-broker",
      "runtime": "jf10",
      "purpose": "JavaScript Injector provider/consumer registration with public and authenticated aggregate-script probes.",
      "installOrder": [
        "@refresh-kit",
        "javascript-injector-jf10",
        "media-preview-jf10",
        "discontinue-watching-jf10",
        "jellysleep-jf10",
        "gelato-jf10",
        "jellyfin-oscars-jf10"
