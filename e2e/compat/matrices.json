      "configurationPatches": [
        {
          "artifactId": "intro-skipper-jf10",
          "payload": {
            "UseFileTransformationPlugin": true,
            "SkipbuttonHideDelay": 13
          }
        }
      ],
      "contentProbes": [
        {
          "id": "intro-skipper-bundle",
          "path": "/web/main.jellyfin.bundle.js",
          "authenticated": false,
          "markers": {
            "intro-skipper-jf10": [
              "false||(t.hideTimeout=setTimeout(t.hideSkipButton.bind(t),13000))",
              ":false||this.hideTimeout||this.hideSkipButton()",
              "isCurrentlyFocusable(document.activeElement)&&t.playbackManager.currentTime()>1000"
            ]
          }
        }
      ],
      "quarantinedAssertions": [
        "Seerr API behavior is not asserted because the lab intentionally has no external Seerr service.",
        "CDN/font delivery is represented by static hostile fixtures because the runtime network is internal-only.",
        "Intro Skipper playback behavior is not asserted because this shell slice does not seed playback media; its real configured core-bundle callback is still required.",
        "MDBList Ratings injects an inline block, so URL stamping is not applicable; its deterministic body marker remains required.",
        "WhisperSubs is isolated in jf10-transform-whisper because File Transformation 2.5.11 selects an exact index.html pipeline ahead of a separately registered regex pipeline; combining them would silently omit WhisperSubs rather than exercise its callback."
