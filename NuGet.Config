<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Do not inherit developer- or runner-specific feeds. Lock-file content
       hashes then bind every restore to the same package bytes from one feed. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <!-- Keep advisory lookup explicit. Reproducible gates disable NuGetAudit;
       the scheduled security gate opts in and treats findings as errors. -->
  <auditSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </auditSources>
</configuration>
