<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Compile the repository-root drop-in exactly as adopters do: without
         any Jellyfin package or the vendored plugin namespace around it. -->
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <AssemblyName>RefreshKit.Standalone.Compile</AssemblyName>
    <RootNamespace>RefreshKit.Standalone.Compile</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>enable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DebugType>portable</DebugType>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
    <NuGetAudit>false</NuGetAudit>
    <EnableSourceLink>false</EnableSourceLink>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <RefreshKitRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../..'))</RefreshKitRepositoryRoot>
    <PathMap>$(RefreshKitRepositoryRoot)=/_/</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Compile Include="../../RefreshKit.cs" Link="RefreshKit.cs" />
  </ItemGroup>

</Project>
